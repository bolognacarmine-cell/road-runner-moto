# Database
MONGODB_URI=mongodb+srv://...
MONGODB_DB_NAME=roadrunner_db
ADMIN_USER=roadrunner
ADMIN_PASSWORD=runner2026
# Obbligatorio per /api/auth/admin-login: segreto HMAC per firmare i cookie di sessione.
# Generare con: openssl rand -hex 32  (in produzione impostarlo come Secret su Render)
ADMIN_SESSION_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Public URLs (Override in Render)
NUXT_PUBLIC_SITE_URL=https://www.road-runner.it
NUXT_PUBLIC_API_BASE=https://road-runner-moto.onrender.com/api
